#!/bin/sh

# --- secret scanning ---
# core.hooksPath sends git here instead of .git/hooks, bypassing the
# `git secrets` hook that ~/.git-templates installs at clone time.
# Without this call the repo has NO secret scanning. Keep it first.
if command -v git-secrets >/dev/null 2>&1; then
  git secrets --pre_commit_hook -- "$@" || exit 1
fi
# --- end secret scanning ---
# Mechanical safeguard for df-orchestrator-committed-release-without-reverifying: the full
# test suite must pass immediately before every commit, not "a few tool calls ago in the same
# turn." This is enforced here, not just documented, because prose reminders already failed
# once (0.16.0 was committed with a genuinely failing test in the suite).
#
# Git sets GIT_DIR/GIT_INDEX_FILE/GIT_WORK_TREE (and friends) for hook processes, pointing at
# THIS repo's (currently locked, mid-commit) .git. The test suite spawns its own child `git`
# processes against throwaway tmp-dir fixtures (tmpRepo(), addHierarchyWorktree(), etc.) — if
# those child processes inherit this hook's git env vars, they operate on the outer repo's
# locked index instead of their own tmp repo, and fail with cryptic "index file open failed"
# errors that look like a test bug but are actually an environment leak. Unset them first.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
set -e
cd "$(git rev-parse --show-toplevel)"

# df-precommit-hook-too-noisy-on-success: quiet on success (one summary line); only dump the
# full node --test output (every test name, the engine banner, etc.) when something actually
# fails. Capture to a temp file, check the real exit code, cat the temp file only on failure.
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

# The suite this hook runs is the ASSERTION HALF -- TWO RUNG GLOBS in ONE runner invocation,
# scripts/test/unit/*.test.mjs and scripts/test/assert/*.test.mjs, under the runner's DEFAULT
# process-per-file isolation (0.49.0, design D3: about half the wall clock of the single-process mode
# 0.47.0 forced, on Node 22, 24 and 26). No TEST spawns a process or runs git; only the runner starts
# one process per file.
# Three notes on the shape, each of them a trap someone has already paid for:
#   * `node --test scripts/test` does NOT work -- on Node 26 a directory argument is treated as
#     a module to execute, so it dies with MODULE_NOT_FOUND and reports "1 test". It exits
#     nonzero so it can't pass silently, but don't "simplify" the glob into a directory.
#   * The glob introduces a NEW silent-loss risk the single-file suite never had: if a file
#     stops matching (renamed, moved, a typo in the pattern), the suite still passes -- just
#     with fewer tests. So below we cross-check the runner's reported count against the number
#     of test() declarations actually present in the TRACKED files of exactly these two rungs. A
#     drop fails.
#   * The OTHER half (scripts/test/functional/) and the sweep bucket (scripts/test/sweeps/) are NOT
#     run here, by design: they are triggered, and this hook runs on every commit. The drift script
#     below is what keeps the two halves aligned when only one of them ran -- it checks the record
#     and the pairing, and it starts no runner of its own.
# CONCURRENCY. Several agents working in separate worktrees of this repo each fire this hook, and
# each run starts up to CPUs-1 test-file processes. Overlapping them is the exact machine load under
# which a previous two-agent run wedged the machine. Worktrees share
# one common git dir, so a lock there is a lock across all of them.
#
# mkdir is the atomic primitive: it succeeds for exactly one caller and fails for the rest, with
# no read-then-write window. macOS ships no flock(1), and a lockfile written with > is not atomic.
LOCKDIR="$(git rev-parse --git-common-dir)/pm-suite.lock"
waited=0
while ! mkdir "$LOCKDIR" 2>/dev/null; do
  # A lock whose owner is gone is stale — a killed agent must not block every later commit.
  owner=$(cat "$LOCKDIR/pid" 2>/dev/null || echo "")
  if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
    echo "pre-commit: clearing a suite lock held by dead pid $owner" >&2
    rm -rf "$LOCKDIR"; continue
  fi
  if [ "$waited" -eq 0 ]; then echo "pre-commit: another worktree is running the suite — waiting" >&2; fi
  sleep 3; waited=$((waited + 3))
  # Ceiling well above one suite run. Hitting it means something is wrong, and a commit that
  # waits forever is worse than one that says so.
  if [ "$waited" -ge 600 ]; then
    echo "pre-commit: ABORT -- waited ${waited}s for the suite lock at $LOCKDIR" >&2
    exit 1
  fi
done
echo $$ > "$LOCKDIR/pid"
trap 'rm -f "$tmpfile"; rm -rf "$LOCKDIR"' EXIT
[ "$waited" -gt 0 ] && echo "pre-commit: acquired the suite lock after ${waited}s"

# ─────────── THE DRIFT SCRIPT (6.4) ───────────
# ONE IMPLEMENTATION OF FOUR RULES, and this hook carries none of them itself. The enrolment check
# lived here INLINE from 5.3 until this task, because a commit between the first file moving and the
# drift script arriving would otherwise be a commit in which a file is run by nothing; 6.4 retires
# that copy as it hands the check over, so the hook stops carrying two versions of one rule.
#
# WHAT IT REFUSES, all four of them by NAME: a tracked test file in neither half and in no bucket;
# a functional id with no assertion twin; a staged functional file without its twin in the same
# staged diff; and a certified module whose STAGED content has no matching contentHash in the record
# -- where the refusal NAMES the run that produces one (`node scripts/test/certify.mjs
# functional|sweeps`) rather than starting it.
#
# IT DOES NOT RUN THE FUNCTIONAL HALF, and that is a requirement rather than a choice (design D8):
# the check must be produced by reading files and the index, with no engine process and no git
# fixture started by it, and it runs BEFORE the suite -- so a check that demanded a record its own
# later step would write would refuse one step too early to ever be satisfied. It starts no test
# runner, no engine and no fixture: `git ls-files`, `git diff --cached`, `git show :path` and
# `git rev-parse --git-common-dir` are the whole of its access, enforced at the call.
#
# BEFORE THE SUITE, INSIDE THE LOCK: it reads the index, and the suite's own writes are irrelevant
# to it, but a refusal should not make the developer wait ~75s for a suite that was never going to
# matter.
#
# `-C "$PWD"` rather than a `cd`, and the git env vars are already unset above -- a drift run against
# an inherited GIT_DIR would read the wrong index and answer about the wrong tree.
if ! node scripts/test/drift.mjs --root "$PWD"; then
  echo "pre-commit: ABORT -- the drift script refused this commit (see above)." >&2
  echo "pre-commit: it checks enrolment, twin coverage, diff coupling and record freshness." >&2
  exit 1
fi

# THE RETIRED ISOLATION PROBE LEFT A FILE BEHIND, and this line is its inverse (0.49.0, design D3).
# Until 0.49.0 the hook probed once per clone for the runner's single-process flag and cached the answer in
# `pm-isolation-flag` beside the suite lock. The probe and the flag are gone; a clone that ran an
# older hook still holds the file, and an untracked file whose only writer is gone reads as a live
# mechanism to the next person who finds it. `rm -f` is idempotent. Sunset: removed in 0.50.0, by
# which time every contributor clone has run this hook at least once.
rm -f "$(git rev-parse --git-common-dir)/pm-isolation-flag"

# ─────────── THE RUNNER'S COMMAND LINE CARRIES THE TWO RUNG GLOBS (0.49.0, design D5) ───────────
# 0.48.x resolved the globs here with a `[ -f ]` loop, because `/bin/sh` leaves a pattern that matches
# NOTHING as a literal and Node 18 REFUSED such a literal (`Could not find …`, exit 1) where Node 26
# ignored it. That loop is HISTORY: every supported Node (22, 24, 26 -- measured on the real
# binaries) runs an unmatched literal pattern as zero files, so one rung matching nothing no longer
# stops the other, and the shell's expansion of a pattern that does match is handed over unchanged.
#
# THE GLOBS STAY PATTERNS ON THE COMMAND LINE, never a list derived from `git ls-files`: that would make the
# runner's set the SAME expression the floor's `declared` is derived from, which is precisely the
# blindness the floor was re-pointed in 0.47.0 to remove. A file that is in the index but unreachable
# by the pattern (the dotfile G-I1's fixture builds) must still be DECLARED and NOT RUN.
#
# AND THE RUNNER IS NEVER WITHOUT A PATH, because the two patterns are always on its command line:
# `node --test` with no positional argument falls back to DEFAULT DISCOVERY, which walks the tree and
# would reach the triggered halves. Both rungs empty is refused on the COUNT below (check 3).

# ONE REPORTER, NO COLOUR, ONE PARSE (0.49.0, design D4). The runner's DEFAULT reporter differs by
# Node major -- TAP (`# tests N`) on 22, spec (`ℹ tests N`) on 24 and 26 -- and the spec reporter
# COLOURS its summary whenever the environment forces colour: every line then begins `ESC[34mℹ`, and
# a `^ℹ tests ` anchor matches nothing. `NO_COLOR=1` does not rescue it (FORCE_COLOR wins). So the
# reporter is FORCED and colour is switched OFF, which makes the summary the same bytes on every
# supported major under any colour setting, and the parse below reads that one format and no other.
if FORCE_COLOR=0 node --test --test-reporter=spec scripts/test/unit/*.test.mjs scripts/test/assert/*.test.mjs >"$tmpfile" 2>&1; then
  total=$(grep -m1 -E '^ℹ tests ' "$tmpfile" | awk '{print $3}')
  passed=$(grep -m1 -E '^ℹ pass ' "$tmpfile" | awk '{print $3}')

  # CHECK 1 -- A COUNT THAT CANNOT BE READ IS A REFUSAL (0.49.0, D4/D5). Until 0.49.0 an unparsed
  # summary still printed "tests passing" and exited 0 WITH THE FLOOR SKIPPED, so
  # any colour-forcing environment disabled the floor silently. The floor is only as good as the
  # count it reads: a floor skipped because the count was unreadable is a floor that did not run.
  if [ -z "$total" ] || [ -z "$passed" ]; then
    echo "pre-commit: ABORT -- the count could not be read: the runner exited 0 but its output holds no" >&2
    echo "pre-commit: '^ℹ tests' / '^ℹ pass' summary line, so the floor has nothing to compare." >&2
    echo "pre-commit: runner output follows" >&2
    cat "$tmpfile" >&2
    exit 1
  fi

  # ─────────── THE FLOOR (5.3), AND ITS INVARIANT ───────────
  # What it compares is what the runner RAN against what the runner was GIVEN, and never against a
  # superset of it. So `declared` is enumerated from the TRACKED files of exactly the half this
  # runner was handed -- THE ASSERTION HALF, which is the only half the hook runs -- and NEVER from
  # the shell's expansion of the runner's own pattern.
  #
  # The two must not be the same expression. They were the same expression until 0.47.0, which is
  # why a file renamed out of the glob dropped from BOTH sides at once and the floor went blind in
  # exactly the case it exists for. Reproduced against the old hook with eight test files, four of
  # them moved under scripts/test/assert/: the runner reported 4, `declared` read 4, the hook
  # exited 0, and four files never ran.
  #
  # ENUMERATING OVER BOTH HALVES HERE IS THE SHAPE THAT MUST NOT BE WRITTEN: it is a superset of
  # what this runner was given, so it aborts on every commit that has a functional half at all
  # (reproduced with three files per half: total=6 declared=15 -> ABORT).
  #
  # `git ls-files`, NOT the glob and NOT `grep -Hc '^test(' scripts/test/assert/*.test.mjs`: the
  # index is the enumeration, and the shell's expansion of the very pattern the runner was handed
  # can shrink in lockstep with it. The while-loop form is deliberate too -- a multi-file `grep -Hc`
  # needs `-H` to keep its filename prefix when the glob matches ONE file (a bare `-c` printed a
  # number, `awk -F:` summed field 2 of nothing and the floor read 0), and one `grep -c` per file
  # has no such trap to fall into.
  # THE DECLARED SET IS THE TWO RUNGS THIS INVOCATION WAS GIVEN AND NOTHING ELSE (0.48.0 task 2.3),
  # enumerated from the TRACKED files of exactly those globs. That is what makes it the same set the
  # runner ran rather than a superset of it — see the comment above for the shape that must NOT be
  # written here, and note this is not it: enumerating over both HALVES is the trap; enumerating over
  # the two RUNGS the runner was handed is the invariant.
  #
  # TWO DECLARATION SHAPES ARE COUNTED, and both belong here: a file-rung test declares itself with
  # `test(`, and a unit-rung test declares itself with `unitTest(` — the wrapper that arms the
  # run-time filesystem counter. Counting only `test(` would give every unit file a declared count of
  # ZERO, so a unit file that stopped running would drop from both sides of the floor at once and the
  # floor would go blind in exactly the case it exists for.
  declared=$(git ls-files 'scripts/test/unit/*.test.mjs' 'scripts/test/assert/*.test.mjs' \
    | while IFS= read -r f; do grep -cE '^(test|unitTest)\(' "$f" || true; done | awk '{s+=$1} END {print s+0}')
  # CHECK 2 -- THE FLOOR, compared BEFORE the empty-rung check (Gate 1 B6). A run that reports fewer
  # tests than are declared -- ZERO INCLUDED -- is a shortfall naming both counts: `total = 0` while the
  # index still declares tests is a COLLAPSED run, and it must never be reported as an empty rung.
  if [ "$total" -lt "$declared" ]; then
    echo "pre-commit: ABORT -- the assertion half ran ${total} tests but ${declared} are declared in" >&2
    echo "pre-commit: its two rungs (scripts/test/unit/ and scripts/test/assert/)." >&2
    echo "pre-commit: A test file is not being picked up; the suite is passing on a subset." >&2
    exit 1
  fi

  # CHECK 3 -- NOTHING DECLARED, SO NOTHING RAN. Only when the index itself declares no test is the
  # refusal "neither rung holds a test file". With both patterns unmatched the runner ran zero files
  # (it was given paths, so it did NOT fall back to default discovery), and zero is never a pass.
  if [ "$declared" -eq 0 ]; then
    echo "pre-commit: ABORT -- neither rung of the assertion half holds a *.test.mjs file" >&2
    echo "pre-commit: (scripts/test/unit/ and scripts/test/assert/ both declare no test) -- a run of" >&2
    echo "pre-commit: zero tests is a refusal, never a pass." >&2
    exit 1
  fi

  echo "pre-commit: ${passed}/${total} passing"
  exit 0
else
  status=$?
  echo "pre-commit: tests FAILED -- full output follows" >&2
  cat "$tmpfile" >&2
  exit "$status"
fi
